	"DocsURL": "https://github.com/kirzo/KzGameplay",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": false,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "KzGameplayUI",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "KzGameplay",
			"Enabled": true
		},
		{
			"Name": "KzUI",
			"Enabled": true
		}
	]
}